<?xml version="1.0"?>
<robot name="static_arm" xmlns:xacro="http://ros.org/wiki/xacro">
    <link name="arm_link">
        <visual>
            <geometry>
                <mesh filename="$(find hippo_sim)/models/static_arm/meshes/simple_gripper.dae" />
            </geometry>
            <material name="purple">
                <color rgba="0.5 0 1 1" />
            </material>
        </visual>
        <collision>
            <geometry>
                <mesh filename="$(find hippo_sim)/models/static_arm/meshes/simple_gripper.dae" />
            </geometry>
        </collision>
        <inertial>
            <mass value="1.0" />
            <origin xyz="0 0 0" />
            <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1" />
        </inertial>
    </link>
</robot>

