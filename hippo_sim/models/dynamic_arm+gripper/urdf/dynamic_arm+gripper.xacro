<?xml version="1.0"?>
<robot name="dynamic_arm" xmlns:xacro="http://ros.org/wiki/xacro">

    <material name="purple">
        <color rgba="0.5 0 1 1" />
    </material>
    <!-- Arm Link -->
    <link name="arm_link">
        <visual>
            <geometry>
                <cylinder radius="0.01" length="1.0" />
            </geometry>
            <origin xyz="0 0 0" />
            <material name="purple" />
        </visual>
    </link>

    <!-- Hand Link -->
    <link name="hand">
        <visual>
            <geometry>
                <box size="0.03 0.1 0.02" />
            </geometry>
            <origin xyz="0 0 0" />
            <material name="purple" />
        </visual>
        <collision>
            <geometry>
                <box size="0.03 0.1 0.02" />
            </geometry>
        </collision>
    </link>

    <!-- Joint between Arm and Hand -->
    <joint name="arm_hand_joint" type="fixed">
        <parent link="arm_link" />
        <child link="hand" />
        <origin xyz="0.0 0.0 0.5" />
    </joint>

    <!-- Left Finger Link -->
    <link name="left_finger">
        <visual>
            <geometry>
                <box size="0.03 0.03 0.2" />
            </geometry>
            <origin xyz="0 0.0 0.0" />
            <material name="purple" />
        </visual>
        <inertial name="left_finger_inertial">
            <mass value="0.001" />
            <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1" />
        </inertial>
        <collision>
            <geometry>
                <box size="0.03 0.03 0.2" />
            </geometry>
        </collision>
    </link>

    <!-- Right Finger Link -->
    <link name="right_finger">
        <visual>
            <geometry>
                <box size="0.03 0.03 0.2" />
            </geometry>
            <origin xyz="0 0.0 0.0" />
            <material name="purple" />
        </visual>
        <inertial name="right_finger_inertial">
            <mass value="0.001" />
            <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1" />
        </inertial>
        <collision>
            <geometry>
                <box size="0.03 0.03 0.2" />
            </geometry>
        </collision>
    </link>

    <!-- Prismatic Joint for Left Finger -->
    <joint name="left_finger_joint" type="prismatic">
        <parent link="hand" />
        <child link="left_finger" />
        <origin xyz="0 0.05 0.10" />
        <axis xyz="0 1 0" />
        <limit lower="0.0" upper="0.05" effort="10" velocity="1" />
    </joint>

    <!-- Prismatic Joint for Right Finger -->
    <joint name="right_finger_joint" type="prismatic">
        <parent link="hand" />
        <child link="right_finger" />
        <origin xyz="0 -0.05 0.10" />
        <axis xyz="0 -1 0" />
        <limit lower="0.0" upper="0.05" effort="10" velocity="1" />
        <mimic joint="finger_left_joint" multiplier="-1.0"/>
    </joint>

      <!-- ros2_control configuration -->
    <ros2_control name="GripperHardware" type="system">
        <hardware>
          <plugin>fake_components/GenericSystem</plugin>
        </hardware>
        <joint name="finger_left_joint">
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
        <joint name="finger_right_joint">
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
    </ros2_control>
