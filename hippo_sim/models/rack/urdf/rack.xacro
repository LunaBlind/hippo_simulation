<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rack">
    <xacro:include filename="$(find hippo_sim)/models/common/urdf/common.xacro" />

    <gazebo>
        <static>true</static>
    </gazebo>
    <link name="base_link">
        <visual>
            <geometry>
                <mesh filename="$(find hippo_sim)/models/rack/meshes/rack_v2.stl" />
                <!-- <mesh filename="/home/yuna/master_thesis/parts/rack_v2.stl" /> -->
            </geometry>
            <material name="gray">
                <color rgba="0.5 0.5 0.5 1" />
            </material>
        </visual>
        <collision>
            <geometry>
                <mesh filename="$(find hippo_sim)/models/rack/meshes/rack_v2.stl" />
                <!-- <mesh filename="/home/yuna/master_thesis/parts/rack_v2.stl" /> -->
            </geometry>
        </collision>
        <inertial>
            <mass value="10" />
            <origin xyz="0 0 0" />
            <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1" />
        </inertial>
    </link>


    <gazebo reference="rack">
        <visual>
            <material>
                <ambient>1 1 1 1</ambient>
                <diffuse>1 1 1 1</diffuse>
                <specular>1 1 1 1</specular>
                <pbr>
                    <metal>
                        <metalness>1</metalness>
                        <roughness>0.5</roughness>
                        <environment_map>$(find hippo_sim)/models/common/textures/env_map.dds</environment_map>
                        <albedo_map>$(find hippo_sim)/models/common/textures/blue.png</albedo_map>
                    </metal>
                </pbr>
            </material>
        </visual>
    </gazebo>

</robot>

