<?xml version="1.0"?>
<robot name="newton_subsea_gripper" xmlns:xacro="http://ros.org/wiki/xacro">

    <!-- Arm Link -->
    <link name="arm_link">
        <visual>
            <geometry>
                <mesh
                    filename="$(find hippo_sim)/models/newton_subsea_gripper/meshes/arm_visual.stl" />
            </geometry>
            <material name="purple">
                <color rgba="0.5 0 1 1" />
            </material>
        </visual>
        <collision>
            <geometry>
                <mesh filename="$(find hippo_sim)/models/newton_subsea_gripper/meshes/arm.stl" />
            </geometry>
        </collision>
        <inertial>
            <mass value="1.0" />
            <origin xyz="0 0 0" rpy="0 0 0" />
            <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1" />
        </inertial>
    </link>

    <!-- Hand Link -->
    <link name="hand">
        <visual>
            <geometry>
                <mesh
                    filename="$(find hippo_sim)/models/newton_subsea_gripper/meshes/hand_visual.stl" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 -3.1415 1.57" />
            <material name="purple" />
        </visual>
        <collision>
            <geometry>
                <mesh filename="$(find hippo_sim)/models/newton_subsea_gripper/meshes/hand.stl" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 -3.1415 1.57" />
        </collision>
    </link>

    <!-- Joint between Arm and Hand -->
    <joint name="arm_hand_joint" type="fixed">
        <parent link="arm_link" />
        <child link="hand" />
        <!-- arm is 195.5 mm long-->
        <!-- offset of 0.035 is needed since the rotation would need to be yaw =-1.57 and not
        1.57-->
        <!-- if correct rotation is used everything aligns but gripper is the wrong way around -->
        <!-- <origin xyz="0 0 -0.1955" rpy="0 -3.1415 1.57" /> -->
        <origin xyz="0.035 0.035 -0.1955" rpy="0 0 0" />
    </joint>

    <!-- Left Finger Link -->
    <link name="left_finger">
        <visual>
            <geometry>
                <mesh
                    filename="$(find hippo_sim)/models/newton_subsea_gripper/meshes/jaw_outer_visual.stl" />
            </geometry>
            <origin xyz="0 0 0.0" rpy="3.1415 0 -1.57" />
            <material name="purple" />
        </visual>
        <collision>
            <geometry>
                <mesh filename="$(find hippo_sim)/models/newton_subsea_gripper/meshes/jaw_outer.stl" />
            </geometry>
            <origin xyz="0 0 0.0" rpy="3.1415 0 -1.57" />
        </collision>
        <inertial name="left_finger_inertial">
            <mass value="0.001" />
            <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1" />
        </inertial>
    </link>

    <!-- Right Finger Link -->
    <link name="right_finger">
        <visual>
            <geometry>
                <mesh
                    filename="$(find hippo_sim)/models/newton_subsea_gripper/meshes/jaw_inner_visual.stl" />
            </geometry>
            <!-- <origin xyz="0 0.0 0.0" /> -->
            <origin xyz="0 0 0.0" rpy="3.1415 0 -1.57" />
            <material name="purple" />
        </visual>
        <collision>
            <geometry>
                <mesh filename="$(find hippo_sim)/models/newton_subsea_gripper/meshes/jaw_inner.stl" />
            </geometry>
            <origin xyz="0 0 0.0" rpy="3.1415 0 -1.57" />
        </collision>
        <inertial name="right_finger_inertial">
            <mass value="0.001" />
            <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1" />
        </inertial>
    </link>
    <!-- Prismatic Joint for Left Finger -->
    <joint name="left_finger_joint" type="revolute">
        <parent link="hand" />
        <child link="left_finger" />
        <origin xyz="0 0 0.0" rpy="0 0 0" />
        <axis xyz="1 0 0" />
        <limit lower="0" upper="0.78" effort="10" velocity="1" />
    </joint>

    <!-- Prismatic Joint for Right Finger -->
    <joint name="right_finger_joint" type="revolute">
        <parent link="hand" />
        <child link="right_finger" />
        <origin xyz="0 0 0.0" rpy="0 0 0" />
        <axis xyz="-1 0 0" />
        <limit lower="0" upper="0.78" effort="10" velocity="1" />
        <mimic joint="left_finger_joint" multiplier="1.0" />
    </joint>

    <ros2_control name="GazeboSystem" type="system">
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
        <joint name="left_finger_joint">
            <command_interface name="position" />
            <state_interface name="position">
                    <!-- pi/4 = 0.78 -->
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
        <joint name="right_finger_joint">
            <param name="mimic">left_finger_joint</param>
            <param name="multiplier">1</param>
            <command_interface name="position" />
            <state_interface name="position" />
            <!-- <state_interface name="position"> -->
            <!--     <param name="initial_value">1.57</param> -->
            <!-- </state_interface> -->
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
    </ros2_control>

    <gazebo>
        <plugin filename="/opt/ros/iron/lib/libgz_ros2_control-system.so"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
          <!-- <robot_param>robot_description</robot_param> -->
          <!-- <robot_param_node>robot_state_publisher</robot_param_node> -->
            <parameters>$(find position_control)/config/gripper_controller.yaml</parameters>
            <!-- <ros> -->
            <!--   <!-1- <namespace>my_namespace</namespace> -1-> -->
            <!--   <remapping>/robot_description:=/robot_description_full</remapping> -->
            <!-- </ros> --> 
        </plugin>
    </gazebo>
</robot>

